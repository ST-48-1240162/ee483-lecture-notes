% Academic title block for handouts
% Usage: \HandoutTitle{3}{Properties of Discrete-Time Systems}{September 1, 2026}
\newcommand{\HandoutTitle}[3]{%
  \renewcommand{\HandoutLectureNum}{#1}%
  \renewcommand{\HandoutLectureSubtitle}{#2}%
  \date{#3}%
  \SetLectureDate{#3}%
  \title{EE 483: Lecture #1: #2}%
  \author{Collected by \HandoutCollectedBy}%
}

\renewcommand{\maketitle}{%
  \begingroup
  \parindent\z@
  \thispagestyle{fancy}%
  \vspace*{-0.25em}%
