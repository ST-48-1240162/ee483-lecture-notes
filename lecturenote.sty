% Manual handout sequence markers (boxed numbers in the left margin).
% Right edge of every mark sits \HandoutMarkInset left of the text-block
% (or tcolorbox frame, which is flush with the text block).
\newcommand{\HandoutMark}[1]{%
  \begingroup
  \setlength{\fboxsep}{2.5pt}%
  \raisebox{-0.15ex}{%
    \fboxrule=0.5pt\fbox{\normalfont\bfseries #1}%
  }%
  \endgroup
}
\newlength{\HandoutMarkInset}
\newlength{\HandoutMarkBoxOffset}
\setlength{\HandoutMarkBoxOffset}{0pt}
\ifhandoutrmtwo
  \setlength{\HandoutMarkInset}{0.22in}
\else
  \setlength{\HandoutMarkInset}{0.42in}
\fi
\makeatletter
\newcommand{\Handout@SyncMarkBoxOffset}{%
  \setlength{\HandoutMarkBoxOffset}{%
    \dimexpr\kvtcb@left@rule+\kvtcb@boxsep+\kvtcb@leftupper\relax
  }%
}
\newcommand{\Handout@ClearMarkBoxOffset}{\setlength{\HandoutMarkBoxOffset}{0pt}}
\tcbset{
  handout mark/.style={
    overlay={%
      \node[anchor=north east, inner sep=0pt]%
        at ([xshift=-\HandoutMarkInset]frame.north west)%
        {\HandoutMark{#1}};%
    }
  }
}
\newcommand{\Handout@HookMarkBox}[1]{%
  \AtBeginEnvironment{#1}{\Handout@SyncMarkBoxOffset}%
  \AfterEndEnvironment{#1}{\Handout@ClearMarkBoxOffset}%
}
\Handout@HookMarkBox{defbox}
\Handout@HookMarkBox{examplebox}
\Handout@HookMarkBox{factbox}
\Handout@HookMarkBox{notebox}
\makeatother
\newcommand{\HandoutMarkMargin}[1]{%
  \llap{\HandoutMark{#1}\hspace{\dimexpr\HandoutMarkInset+\HandoutMarkBoxOffset\relax}}%
}
\newcommand{\HandoutMarkLeft}[1]{\HandoutMarkMargin{#1}}
% Mark at the left margin before a display-math block inside a tcolorbox.
% After \end{align*} etc., the horizontal anchor sits at the frame edge, not
% the text inset, so do not add \HandoutMarkBoxOffset here.
\newcommand{\HandoutMarkBeforeAlign}[1]{%
  \par\noindent\llap{\HandoutMark{#1}\hspace{\HandoutMarkInset}}%
  \vspace{-\baselineskip}%
}
% Mark in the left margin, vertically aligned with the top of a tcolorbox frame.
\newcommand{\HandoutBeginMarkedExamplebox}[2][Example]{%
  \begin{examplebox}[title={#1}, handout mark=#2]%
}
\newcommand{\HandoutEndMarkedExamplebox}{\end{examplebox}}
\newcommand{\HandoutBeginMarkedFactbox}[2][Fact]{%
  \begin{factbox}[title={#1}, handout mark=#2]%
}
\newcommand{\HandoutEndMarkedFactbox}{\end{factbox}}
\newcommand{\HandoutMarkSection}[2]{%
  \Needspace{3\baselineskip}%
  \def\HandoutPendingMark{#1}%
  \section{#2}%
  \let\HandoutPendingMark\empty
}
\newcommand{\HandoutMarkSubsection}[2]{%
  \Needspace{3\baselineskip}%
  \def\HandoutPendingMark{#1}%
  \subsection{#2}%
  \let\HandoutPendingMark\empty
}
% Marked run-in heading: embed margin number in the paragraph title itself.
\newcommand{\HandoutMarkParagraph}[2]{%
  \Needspace{2\baselineskip}%
  \paragraph{\HandoutMarkMargin{#1}#2}%
}

% Mitra textbook equation reference (4th ed.).
% \tag{} adds parentheses automatically; do not wrap tag text in ().
\newcommand{\HandoutMitraTagText}[1]{\text{\scriptsize\textit{Mitra~#1}}}
\newcommand{\HandoutMitraInlineText}[1]{\;\text{\scriptsize\textit{(Mitra~#1)}}}
\newcommand{\MitraEq}[1]{\HandoutMitraInlineText{#1}}  % inline, after prose or $...$
\newcommand{\MitraTag}[1]{\tag{\HandoutMitraTagText{#1}}}  % right-aligned in display math
\newcommand{\MitraEqDoubt}[1]{\HandoutMitraInlineText{#1}\textcolor{red}{?}}
\newcommand{\MitraEqDoubtTag}[1]{\tag{\HandoutMitraTagText{#1}\textcolor{red}{?}}}
\newcommand{\HandoutMitraSecRef}[1]{\textnormal{(cf.\ Mitra~Sec.~#1)}}

% Suppress automatic (1), (2), ... equation numbers; keep \tag / \MitraTag.
\makeatletter
\newif\ifHandout@eqtag
\Handout@eqtagfalse
\AtBeginEnvironment{equation}{\Handout@eqtagfalse}
\AtBeginEnvironment{align}{\Handout@eqtagfalse}
\AtBeginEnvironment{gather}{\Handout@eqtagfalse}
\AtBeginEnvironment{multline}{\Handout@eqtagfalse}
\AtBeginDocument{%
  \let\Handout@orig@tag\tag
  \renewcommand{\tag}[1]{%
    \Handout@eqtagtrue
    \Handout@orig@tag{#1}%
  }%
  \renewcommand{\tagform@}[1]{%
    \ifHandout@eqtag
      \maketag@@{#1}%
    \fi
  }%
}
\makeatother

% Gain block: vertical left edge, apex pointing right.
\tikzset{
  handout gain block/.style={
    inner sep=1pt,
    minimum height=0.75cm,
    minimum width=0.72cm,
    path picture={
      \draw
        (path picture bounding box.west |- path picture bounding box.south)
        -- (path picture bounding box.west |- path picture bounding box.north)
        -- (path picture bounding box.east)
        -- cycle;
    },
  }
}

% Scalar multiplication block diagram: x[n] -> A -> y[n].
\newcommand{\HandoutScalarMultDiagram}{%
  \tikz[baseline=-0.6ex, >=Latex]{%
    \node (x) at (0,0) {$x[n]$};
    \node[handout gain block] (A) at (1.5,0) {$A$};
    \node (y) at (3,0) {$y[n]$};
    \draw[->, thick] (x.east) -- (A.west);
    \draw[->, thick] (A.east) -- (y.west);
  }%
}

% Branching: one input splits into two identical outputs.
\newcommand{\HandoutBranchingDiagram}{%
  \tikz[baseline=-0.6ex, >=Latex]{%
    \node (input) at (0,0) {$x[n]$};
    \coordinate (junction) at (1.5,0);
    \node (right-output) at (3.2,0) {$x[n]$};
    \node (bottom-output) at (1.5,-1.2) {$x[n]$};
    \draw[thick] (input.east) -- (junction);
    \fill (junction) circle (2.5pt);
    \draw[->, thick] (junction) -- (right-output.west);
    \draw[->, thick] (junction) -- (bottom-output.north);
  }%
}

% Addition: sum of x[n] and w[n].
\newcommand{\HandoutAdditionDiagram}{%
  \tikz[baseline=-0.6ex, >=Latex]{%
    \node (x) at (0,0) {$x[n]$};
    \node[draw, circle, inner sep=2pt] (sum) at (2,0) {$+$};
    \node (y) at (5,0) {$y[n]=x[n]+w[n]$};
    \node (w) at (2,-1.2) {$w[n]$};
    \draw[->, thick] (x.east) -- (sum.west);
    \draw[->, thick] (w.north) -- (sum.south);
    \draw[->, thick] (sum.east) -- (y.west);
  }%
}

% Product (modulation): multiply x[n] and w[n].
\newcommand{\HandoutModulationDiagram}{%
  \tikz[baseline=-0.6ex, >=Latex]{%
    \node (x) at (0,0) {$x[n]$};
    \node[draw, circle, inner sep=2pt] (mult) at (2,0) {$\times$};
    \node (y) at (5,0) {$y[n]=x[n]w[n]$};
    \node (w) at (2,-1.2) {$w[n]$};
    \draw[->, thick] (x.east) -- (mult.west);
    \draw[->, thick] (w.north) -- (mult.south);
    \draw[->, thick] (mult.east) -- (y.west);
  }%
}

% Two-tap FIR filter block diagram (Example).
\newcommand{\HandoutTwoTapFIRDiagram}{%
  \begin{tikzpicture}[>=Latex, node distance=1cm]
    \node (x) at (0,0) {$x[n]$};
    \coordinate (branch) at (1.3,0);
    \node[handout gain block] (a0) at (2.6,0) {$a_0$};
    \node[draw, rectangle, minimum width=0.8cm,
      minimum height=0.6cm] (delay) at (2,-1.2) {$z^{-1}$};
    \node[handout gain block] (a1) at (3.4,-1.2) {$a_1$};
    \node[draw, circle, inner sep=2pt] (sum) at (4.7,0) {$+$};
    \node (y) at (6.3,0) {$y[n]$};
    \draw[thick] (x.east) -- (branch);
    \fill (branch) circle (2.5pt);
    \draw[->, thick] (branch) -- (a0.west);
    \draw[->, thick] (a0.east) -- (sum.west);
    \draw[->, thick] (branch) |- (delay.west);
    \draw[->, thick] (delay.east) -- (a1.west);
    \draw[->, thick] (a1.east) -| (sum.south);
    \draw[->, thick] (sum.east) -- (y.west);
    \draw[thick]
      (0.8,0.75) rectangle (5.5,-1.8);
    \node[anchor=south west, inner sep=2pt] at (5.5,0.75) {$H$};
  \end{tikzpicture}%
}

