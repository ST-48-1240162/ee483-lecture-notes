  \vspace{0.5em}%
  {\large Lecture \HandoutLectureNum: \HandoutLectureSubtitle\par}%
  \vspace{1.25em}%
  {\small
    \renewcommand{\arraystretch}{1.2}%
    \begin{tabular}{@{}l@{\quad}l@{}}%
      \textit{Lecturer}      & \HandoutLecturer \\%
      \textit{Collected by} & \HandoutCollectedBy \\%
