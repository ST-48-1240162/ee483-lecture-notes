% Boxed environments: Definition, Example, Fact/Property, Note
\newtcolorbox{defbox}[1][]{%
  academic,
  colback=defbg,
  title={Definition},
  #1
}
\newtcolorbox{examplebox}[1][]{%
  academic,
  colback=exbg,
  colframe=exframe,
  boxrule=0.7pt,
  fonttitle=\bfseries\itshape,
  title={Example},
  #1
}
\newtcolorbox{factbox}[1][]{%
  academic,
  colback=factbg,
  title={Fact},
  #1
}
\newtcolorbox{notebox}[1][]{%
  academic,
  colback=notebg,
  boxrule=0.3pt,
  colframe=ee483rule!60,
  fonttitle=\bfseries\itshape,
  title={Remark},
  #1
}

% Keep each styled block on one page; only guard against orphaned titles.
