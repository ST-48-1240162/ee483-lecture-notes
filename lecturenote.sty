% Section styling (numbered, understated)
\let\HandoutPendingMark\empty
\newcommand{\HandoutSectionLabelFormat}{%
  \ifx\HandoutPendingMark\empty\else\HandoutMarkMargin{\HandoutPendingMark}\fi
  \thesection
}
\newcommand{\HandoutSubsectionLabelFormat}{%
  \ifx\HandoutPendingMark\empty\else\HandoutMarkMargin{\HandoutPendingMark}\fi
  \thesubsection
}
\titleformat{\section}
  {\normalfont\Large\bfseries\color{ee483ink}}
  {\HandoutSectionLabelFormat}{0.75em}{}
\titleformat{\subsection}
  {\normalfont\large\bfseries\color{ee483ink}}
  {\HandoutSubsectionLabelFormat}{0.75em}{}
\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries\itshape\color{ee483ink}}
  {\thesubsubsection}{0.75em}{}
\titlespacing*{\section}{0pt}{14pt plus 4pt minus 2pt}{8pt plus 2pt minus 2pt}
